# Copy to .env and fill in locally. Never commit .env.
# Model id in LangChain init_chat_model format: "google_genai:<model-id>"
# Copy the exact free-tier model id from Google AI Studio (e.g. a current "Flash" model).
LLM_MODEL=google_genai:gemini-2.5-flash
# Create a key at Google AI Studio; read automatically by langchain-google-genai.
GOOGLE_API_KEY=
# Postgres (docker compose up -d db). Local-dev credentials only.
DB_URI=postgresql://rfp:rfp@127.0.0.1:5432/rfp
